# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Firebase client config (public — safe to expose to the browser) ---
# From Firebase Console > Project Settings > General > Your apps > SDK setup and config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only secret — service account) ---
# From Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key as a single line with literal \n for newlines
FIREBASE_ADMIN_PRIVATE_KEY=

# Comma-separated list of emails to grant the admin custom claim on bootstrap
ADMIN_EMAILS=

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paystack ---
# Server-only. Never prefix with NEXT_PUBLIC_. Checkout uses Paystack's
# redirect flow (authorization_url), so no public key is needed client-side.
PAYSTACK_SECRET_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Luxury Furniture <orders@yourdomain.com>"

# --- Cron ---
# Bearer token required by /api/cron/* routes. Also set as the Authorization
# header value on the Vercel Cron job / external scheduler.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
